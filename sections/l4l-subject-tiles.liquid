<div class="l4l-subjects page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="l4l-subjects__heading">{{ section.settings.heading }}</h2>
    <span class="l4l-subjects__accent"></span>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="l4l-subjects__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- assign subjects = shop.metaobjects.subject.values | sort: 'sort_order' -%}

  <div class="l4l-subjects__grid">
    {%- for subject in subjects -%}
      {%- if subject.coming_soon.value -%}
        <div class="l4l-subject-card l4l-subject-card--soon" style="--subject-color: {{ subject.color.value }};">
          <span class="l4l-subject-card__badge">Coming soon</span>
          <span class="l4l-subject-card__icon">{{ subject.icon.value }}</span>
          <div>
            <p class="l4l-subject-card__title">{{ subject.name.value }}</p>
            <p class="l4l-subject-card__text">{{ subject.description.value }}</p>
          </div>
        </div>
      {%- else -%}
        <a href="{{ subject.link.value.url }}" class="l4l-subject-card" style="--subject-color: {{ subject.color.value }};">
          <span class="l4l-subject-card__icon">{{ subject.icon.value }}</span>
          <div>
            <p class="l4l-subject-card__title">{{ subject.name.value }}</p>
            <p class="l4l-subject-card__text">{{ subject.description.value }}</p>
            <span class="l4l-subject-card__cta">Shop {{ subject.name.value }} &rarr;</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- assign has_coming_soon = false -%}
{%- for subject in subjects -%}
  {%- if subject.coming_soon.value -%}
    {%- assign has_coming_soon = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_coming_soon -%}
  <div class="l4l-notify-wrap">
    <div class="l4l-notify page-width">
      <p class="l4l-notify__heading">Want to know when new subjects launch?</p>
      <p class="l4l-notify__subheading">Pick the ones you're interested in and we'll email you the moment they're ready.</p>

      {%- form 'customer', id: 'notify-form', class: 'l4l-notify__form' -%}
        <input type="hidden" name="contact[tags]" id="notify-tags-field" value="">
        {%- if form.posted_successfully? -%}
          <p class="l4l-notify__success">You're on the list! We'll be in touch when these launch.</p>
          <div class="l4l-notify__checkboxes" data-notify-fallback style="display:none;">
            {%- for subject in subjects -%}
              {%- if subject.coming_soon.value -%}
                <label class="l4l-notify__checkbox" style="--subject-color: {{ subject.color.value }};">
                  <input type="checkbox" class="l4l-notify__checkbox-input" data-tag="notify-{{ subject.name.value | handleize }}">
                  <span class="l4l-notify__checkbox-icon">{{ subject.icon.value }}</span>
                  {{ subject.name.value }}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="l4l-notify__row" data-notify-fallback style="display:none;">
            <input type="email" name="contact[email]" placeholder="Your email" required class="l4l-notify__input">
            <button type="submit" class="l4l-notify__btn">Notify me</button>
          </div>
        {%- else -%}
          <div class="l4l-notify__checkboxes">
            {%- for subject in subjects -%}
              {%- if subject.coming_soon.value -%}
                <label class="l4l-notify__checkbox" style="--subject-color: {{ subject.color.value }};">
                  <input type="checkbox" class="l4l-notify__checkbox-input" data-tag="notify-{{ subject.name.value | handleize }}">
                  <span class="l4l-notify__checkbox-icon">{{ subject.icon.value }}</span>
                  {{ subject.name.value }}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="l4l-notify__row">
            <input type="email" name="contact[email]" placeholder="Your email" required class="l4l-notify__input">
            <button type="submit" class="l4l-notify__btn">Notify me</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <script>
    (function () {
      var form = document.getElementById('notify-form');
      if (!form) return;
      form.addEventListener('submit', function () {
        var checked = form.querySelectorAll('.l4l-notify__checkbox-input:checked');
        var tags = Array.prototype.map.call(checked, function (el) { return el.getAttribute('data-tag'); });
        document.getElementById('notify-tags-field').value = tags.join(',');
      });

      var successEl = form.querySelector('.l4l-notify__success');
      if (successEl && window.location.hash !== '#notify-form') {
        successEl.style.display = 'none';
        form.querySelectorAll('[data-notify-fallback]').forEach(function (el) {
          el.style.display = el.classList.contains('l4l-notify__row') ? 'flex' : '';
        });
      }
    })();
  </script>
{%- endif -%}

<style>
  .l4l-subjects {
    padding: 5rem 0;
    text-align: center;
  }
  .l4l-subjects__heading {
    font-size: 2.8rem;
    margin: 0 0 0.5rem;
  }
  .l4l-subjects__accent {
    display: inline-block;
    width: 5.6rem;
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #C98A3E, #0B2545);
    margin: 0 0 1.6rem;
  }
  .l4l-subjects__subheading {
    opacity: 0.7;
    font-size: 1.5rem;
    margin: 0 0 2.5rem;
  }
  .l4l-subjects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: left;
  }
  @media screen and (max-width: 989px) {
    .l4l-subjects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 599px) {
    .l4l-subjects__grid {
      grid-template-columns: 1fr;
    }
  }
  .l4l-subject-card {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 1.8rem;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 1.2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .l4l-subject-card:hover {
    border-color: var(--subject-color);
  }
  .l4l-subject-card__icon {
    font-size: 2.6rem;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--subject-color) 15%, white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .l4l-subject-card__title {
    font-weight: 600;
    font-size: 1.7rem;
    margin: 0 0 0.3rem;
  }
  .l4l-subject-card__text {
    font-size: 1.3rem;
    opacity: 0.75;
    margin: 0 0 0.6rem;
  }
  .l4l-subject-card__cta {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--subject-color);
  }
  .l4l-subject-card--soon {
    position: relative;
    opacity: 0.6;
  }
  .l4l-subject-card__badge {
    position: absolute;
    top: -0.8rem;
    right: 1.4rem;
    background: #0B2545;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
  }
  .l4l-notify-wrap {
    background: #FAFAF8;
    margin-top: 3.5rem;
    padding: 3rem 0;
  }
  .l4l-notify {
    text-align: center;
  }
  .l4l-notify__heading {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }
  .l4l-notify__subheading {
    font-size: 1.4rem;
    opacity: 0.7;
    margin: 0 0 1.8rem;
  }
  .l4l-notify__checkboxes {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }
  .l4l-notify__checkbox {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.4rem;
    border: 1.5px solid rgba(0,0,0,0.12);
    border-radius: 999px;
    font-size: 1.35rem;
    font-weight: 500;
    cursor: pointer;
    background: #fff;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .l4l-notify__checkbox:has(.l4l-notify__checkbox-input:checked) {
    border-color: var(--subject-color);
    background: color-mix(in srgb, var(--subject-color) 10%, white);
  }
  .l4l-notify__checkbox-input {
    accent-color: var(--subject-color);
    width: 1.6rem;
    height: 1.6rem;
  }
  .l4l-notify__checkbox-icon {
    font-size: 1.6rem;
  }
  .l4l-notify__row {
    display: flex;
    gap: 0.8rem;
    max-width: 44rem;
    margin: 0 auto;
  }
  .l4l-notify__input {
    flex: 1;
    min-width: 0;
    padding: 1rem 1.4rem;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 0.8rem;
    font-size: 1.4rem;
    font-family: inherit;
  }
  .l4l-notify__btn {
    padding: 1rem 1.8rem;
    border: none;
    border-radius: 0.8rem;
    background: #0B2545;
    color: #fff;
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .l4l-notify__success {
    font-size: 1.5rem;
    font-weight: 600;
    color: #0F6E56;
    margin: 0;
  }
  @media screen and (max-width: 599px) {
    .l4l-notify__row {
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "L4L Subject tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse by subject" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Explore our growing library of standards-aligned subjects" }
  ],
  "presets": [
    { "name": "L4L Subject tiles" }
  ]
}
{% endschema %}
