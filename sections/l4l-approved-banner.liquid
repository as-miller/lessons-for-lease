<div class="l4l-approved page-width">
  <div class="l4l-approved__inner">
    <div class="l4l-approved__left">
      <span class="l4l-approved__badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>
      </span>
      <div>
        <p class="l4l-approved__title">{{ section.settings.heading | default: 'Teacher approved. Parent trusted.' }}</p>
        <p class="l4l-approved__text">{{ section.settings.text | default: "We're teachers too. Every resource is created with real classrooms in mind and designed to save you time while helping your students succeed." }}</p>
      </div>
    </div>
    <div class="l4l-approved__right">
      {%- for block in section.blocks -%}
        <div class="l4l-approved__item" {{ block.shopify_attributes }}>
          <span class="l4l-approved__item-icon">{{ block.settings.icon }}</span>
          <p>{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .l4l-approved {
    padding: 2.5rem 0;
  }
  .l4l-approved__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background: rgba(15,110,86,0.05);
    border: 1px solid rgba(15,110,86,0.15);
    border-radius: 1.2rem;
    padding: 2rem 2.4rem;
  }
  .l4l-approved__left {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    max-width: 46rem;
  }
  .l4l-approved__badge {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: #0F6E56;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .l4l-approved__badge svg {
    width: 2.2rem;
    height: 2.2rem;
  }
  .l4l-approved__title {
    font-weight: 700;
    font-size: 1.6rem;
    margin: 0 0 0.3rem;
  }
  .l4l-approved__text {
    font-size: 1.3rem;
    opacity: 0.75;
    margin: 0;
    line-height: 1.5;
  }
  .l4l-approved__right {
    display: flex;
    gap: 2.2rem;
    flex-wrap: wrap;
  }
  .l4l-approved__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.3rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .l4l-approved__item-icon {
    font-size: 1.8rem;
  }
  .l4l-approved__item p {
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "L4L Approved banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Teacher approved. Parent trusted." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're teachers too. Every resource is created with real classrooms in mind and designed to save you time while helping your students succeed." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "⭐" },
        { "type": "text", "id": "label", "label": "Label", "default": "Quality you can trust" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "L4L Approved banner",
      "blocks": [
        { "type": "item", "settings": { "icon": "⭐", "label": "Quality you can trust" } },
        { "type": "item", "settings": { "icon": "⏱", "label": "Save time every week" } },
        { "type": "item", "settings": { "icon": "🎧", "label": "Support when you need it" } }
      ]
    }
  ]
}
{% endschema %}
