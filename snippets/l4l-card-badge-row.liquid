{%- comment -%}
  Renders the Grade and Format badge row above the product title.
  Usage: {% render 'l4l-card-badge-row', product: card_product %}
{%- endcomment -%}

{%- liquid
  assign grade = product.metafields.curriculum.grade.value
  assign hide_grade = product.metafields.curriculum.hide_grade_badge.value
  assign hide_format = product.metafields.curriculum.hide_format_badge.value
  assign formats = ''
  for variant in product.variants
    assign formats = formats | append: variant.title | append: ','
  endfor
-%}

{%- if grade and hide_grade != true or product.has_only_default_variant == false and hide_format != true -%}
  <div class="l4l-card-badge-row">
    {%- if grade and hide_grade != true -%}
      <span class="l4l-card-badge l4l-card-badge--grade" style="--badge-color: {{ grade.color.value | default: '#0F6E56' }};">{{ grade.name.value }}</span>
    {%- endif -%}
    {%- if product.has_only_default_variant == false and hide_format != true -%}
      {%- if formats contains 'Print' and formats contains 'Digital' -%}
        <span class="l4l-card-badge l4l-card-badge--format">Print + Digital</span>
      {%- elsif formats contains 'Digital' -%}
        <span class="l4l-card-badge l4l-card-badge--format">Digital</span>
      {%- elsif formats contains 'Print' -%}
        <span class="l4l-card-badge l4l-card-badge--format">Print</span>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  .l4l-card-badge-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0.8rem 0 0.4rem;
  }
  .card__content:has(.l4l-card-badge-row) {
    background: #fff !important;
    position: static !important;
    border-bottom-left-radius: 12px !important;
    border-bottom-right-radius: 12px !important;
  }
  .l4l-card-badge {
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.3rem 0.9rem;
    border-radius: 0.7rem;
    display: inline-block;
  }
  .l4l-card-badge--grade {
    background: color-mix(in srgb, var(--badge-color, #0F6E56) 16%, white);
    color: var(--badge-color, #0F6E56);
  }
  .l4l-card-badge--format {
    background: rgba(0,0,0,0.06);
    color: rgba(0,0,0,0.65);
  }
</style>
