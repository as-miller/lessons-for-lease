<div class="l4l-subjects page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="l4l-subjects__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="l4l-subjects__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}
  <div class="l4l-subjects__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="l4l-subject-card" style="--subject-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
        <span class="l4l-subject-card__icon">{{ block.settings.icon }}</span>
        <div>
          <p class="l4l-subject-card__title">{{ block.settings.title }}</p>
          <p class="l4l-subject-card__text">{{ block.settings.text }}</p>
          <span class="l4l-subject-card__cta">Shop {{ block.settings.title }} →</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

<style>
  .l4l-subjects {
    padding: 5rem 0;
    text-align: center;
  }
  .l4l-subjects__heading {
    font-size: 2.8rem;
    margin: 0 0 0.5rem;
  }
  .l4l-subjects__subheading {
    opacity: 0.7;
    font-size: 1.5rem;
    margin: 0 0 2.5rem;
  }
  .l4l-subjects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    text-align: left;
  }
  .l4l-subject-card {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 1.8rem;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 1.2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .l4l-subject-card:hover {
    border-color: var(--subject-color);
  }
  .l4l-subject-card__icon {
    font-size: 2.6rem;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--subject-color) 15%, white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .l4l-subject-card__title {
    font-weight: 600;
    font-size: 1.7rem;
    margin: 0 0 0.3rem;
  }
  .l4l-subject-card__text {
    font-size: 1.3rem;
    opacity: 0.75;
    margin: 0 0 0.6rem;
  }
  .l4l-subject-card__cta {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--subject-color);
  }
</style>

{% schema %}
{
  "name": "L4L Subject tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse by subject" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Explore our growing library of standards-aligned subjects" }
  ],
  "blocks": [
    {
      "type": "subject",
      "name": "Subject",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🔢" },
        { "type": "text", "id": "title", "label": "Title", "default": "Math" },
        { "type": "text", "id": "text", "label": "Description", "default": "Build confidence with engaging, standards-aligned math lessons" },
        { "type": "color", "id": "color", "label": "Subject color", "default": "#1F3A5F" },
        { "type": "url", "id": "link", "label": "Collection link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "L4L Subject tiles",
      "blocks": [
        { "type": "subject", "settings": { "icon": "🔢", "title": "Math", "text": "Build confidence with engaging, standards-aligned math lessons", "color": "#0B2545" } },
        { "type": "subject", "settings": { "icon": "📖", "title": "ELA", "text": "Help students grow in reading, writing, and grammar", "color": "#0F6E56" } }
      ]
    }
  ]
}
{% endschema %}
