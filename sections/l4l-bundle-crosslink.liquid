{%- liquid
  assign parent_bundle = product.metafields.curriculum.included_in_bundle.value
  assign bundle_lessons = product.metafields.curriculum.bundle_lessons.value
-%}

{%- if parent_bundle -%}
  <div class="l4l-crosslink page-width">
    <a href="{{ parent_bundle.url }}" class="l4l-crosslink__banner">
      <span class="l4l-crosslink__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/></svg>
      </span>
      <span class="l4l-crosslink__text">
        <strong>This lesson is part of {{ parent_bundle.title }}</strong>
        <span>Save by buying the full set &rarr;</span>
      </span>
    </a>
  </div>
{%- endif -%}

{%- if bundle_lessons.size > 0 -%}
  <div class="l4l-crosslink page-width">
    <div class="l4l-crosslink__card">
      <p class="l4l-crosslink__card-title">This bundle includes {{ bundle_lessons.size }} lessons</p>
      <div class="l4l-crosslink__lesson-grid">
        {%- for lesson in bundle_lessons -%}
          <a href="{{ lesson.url }}" class="l4l-crosslink__lesson">
            <span class="l4l-crosslink__lesson-check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            {{ lesson.title }}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  .l4l-crosslink {
    padding: 0 0 2rem;
  }
  .l4l-crosslink__banner {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    background: #FAEEDA;
    border-radius: 1.2rem;
    padding: 1.6rem 2rem;
    text-decoration: none;
    color: inherit;
  }
  .l4l-crosslink__icon {
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 1rem;
    background: #fff;
    color: #854F0B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .l4l-crosslink__icon svg {
    width: 2.1rem;
    height: 2.1rem;
  }
  .l4l-crosslink__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .l4l-crosslink__text strong {
    font-size: 1.5rem;
  }
  .l4l-crosslink__text span {
    font-size: 1.3rem;
    color: #854F0B;
    font-weight: 600;
  }
  .l4l-crosslink__card {
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 1.2rem;
    padding: 2rem;
  }
  .l4l-crosslink__card-title {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 1.4rem;
  }
  .l4l-crosslink__lesson-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.8rem;
  }
  .l4l-crosslink__lesson {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    text-decoration: none;
    color: inherit;
    padding: 0.6rem 0;
  }
  .l4l-crosslink__lesson:hover {
    color: #0F6E56;
  }
  .l4l-crosslink__lesson-check {
    width: 1.8rem;
    height: 1.8rem;
    color: #0F6E56;
    flex-shrink: 0;
  }
</style>

{% schema %}
{
  "name": "L4L Bundle cross-link",
  "settings": [],
  "presets": [
    { "name": "L4L Bundle cross-link" }
  ]
}
{% endschema %}
